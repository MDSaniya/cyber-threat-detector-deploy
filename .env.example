# ╔═══════════════════════════════════════════════════════════════╗
# ║     CyberFedDefender - Environment Configuration (.env)        ║
# ║     Copy this file to .env and fill in your values              ║
# ╚═══════════════════════════════════════════════════════════════╝

# ────────────────────────────────────────────────────────────────
# FLASK CORE CONFIGURATION (REQUIRED)
# ────────────────────────────────────────────────────────────────

FLASK_ENV=production
FLASK_APP=app.py

# SECURITY: Generate a strong secret key (32+ random characters)
# Use: python -c "import secrets; print(secrets.token_hex(32))"
# Or: python -c "import os; print(os.urandom(24).hex())"
SECRET_KEY=your-secret-key-here-generate-random-32-chars-minimum

# Debug mode (NEVER True in production)
DEBUG=False


# ────────────────────────────────────────────────────────────────
# SERVER CONFIGURATION
# ────────────────────────────────────────────────────────────────

# Port (Railway/Render/Heroku set this automatically via $PORT)
PORT=5000

# Host binding (0.0.0.0 for production servers)
HOST=0.0.0.0

# Number of Gunicorn workers (CPU cores x 2 + 1, e.g., 4-core = 9)
WORKERS=4

# Gunicorn timeout in seconds
TIMEOUT=120


# ────────────────────────────────────────────────────────────────
# LOGGING & MONITORING
# ────────────────────────────────────────────────────────────────

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Application environment name (for monitoring dashboards)
APP_ENV=production
APP_VERSION=1.0.0
APP_NAME=CyberFedDefender


# ────────────────────────────────────────────────────────────────
# ML MODEL CONFIGURATION (If using trained models)
# ────────────────────────────────────────────────────────────────

# Path to trained model files
MODEL_PATH=models/rf_pso_model.pkl
SCALER_PATH=models/scaler.pkl
LABEL_ENCODERS_PATH=models/label_encoders.pkl
FEATURE_NAMES_PATH=models/feature_names.pkl

# Whether to load actual models (vs using simulated results)
USE_TRAINED_MODELS=False


# ────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION (If adding database)
# ────────────────────────────────────────────────────────────────

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# Format for Railway: postgresql://username:password@host:5432/database

# MongoDB (if using for data storage)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# SQLite (simpler alternative, file-based)
# SQLALCHEMY_DATABASE_URI=sqlite:///threat_detector.db


# ────────────────────────────────────────────────────────────────
# SECURITY & CORS
# ────────────────────────────────────────────────────────────────

# Allowed domains for CORS (comma-separated)
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Session cookie security
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax


# ────────────────────────────────────────────────────────────────
# EXTERNAL SERVICES (Optional)
# ────────────────────────────────────────────────────────────────

# Email notifications (SendGrid, Gmail, etc.)
# SMTP_SERVER=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your-sendgrid-key-here
# SMTP_FROM_EMAIL=noreply@cyberfeddefender.com

# Cloud storage (AWS S3, Google Cloud Storage, etc.)
# AWS_ACCESS_KEY_ID=your-key-here
# AWS_SECRET_ACCESS_KEY=your-secret-here
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1

# API Keys for external threat intelligence
# VIRUS_TOTAL_API_KEY=your-api-key-here
# SHODAN_API_KEY=your-api-key-here


# ────────────────────────────────────────────────────────────────
# PLATFORM-SPECIFIC VARIABLES
# ────────────────────────────────────────────────────────────────

# Railway.app (automatically provided)
# RAILWAY_ENVIRONMENT=production

# Render.com (automatically provided)
# RENDER_GIT_COMMIT=<commit-hash>

# Heroku (automatically provided)
# HEROKU_APP_NAME=your-app-name
# DYNO_TYPE=web

# PythonAnywhere
# PA_USERNAME=your-username
# PA_API_TOKEN=your-api-token


# ────────────────────────────────────────────────────────────────
# FEATURE FLAGS (For A/B Testing)
# ────────────────────────────────────────────────────────────────

# FEATURE_ML_MODELS=True
# FEATURE_LIVE_TRAFFIC=True
# FEATURE_EXPORT_REPORTS=False
# FEATURE_USER_AUTH=False


# ────────────────────────────────────────────────────────────────
# IMPORTANT SECURITY NOTES
# ────────────────────────────────────────────────────────────────
# 1. NEVER commit .env to Git (it's in .gitignore)
# 2. NEVER use the same SECRET_KEY across environments
# 3. Generate unique keys for each deployment:
#    python -c "import secrets; print(secrets.token_hex(32))"
# 4. Store all sensitive data in platform's secret manager:
#    - Railway: Project Settings > Secrets
#    - Render: Environment > Secrets
#    - Heroku: Settings > Config Vars
# 5. Rotate API keys regularly
# 6. Use strong, unique passwords for databases
